# ---------------------------------------------------------------------------
# Bite & Sips environment. Copy to .env.local (development) and fill in.
# NEVER commit real values. Only NEXT_PUBLIC_* variables reach the browser —
# this app uses none, so every value below stays on the server.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# PostgreSQL connection (local, Docker, Supabase "session"/direct string, Neon, etc.)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biteandsips
# disable | prefer | require   (use "require" for managed/cloud databases)
DATABASE_SSL=disable
# Public base URL of the site (used for payment callbacks and tracking links)
APP_URL=http://localhost:3001
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-32-plus-random-characters-xxxxxxxx

# --- Payments ---------------------------------------------------------------
# mock     = simulated payments for development (blocked in production)
# paystack = live/test Paystack (requires PAYSTACK_SECRET_KEY)
# none     = no online payment (cash only, if enabled in Admin → Settings)
PAYMENT_PROVIDER=mock
# Paystack secret key (sk_test_… for testing, sk_live_… in production). Server-only.
PAYSTACK_SECRET_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co

# --- Background jobs ------------------------------------------------------------
# Secret for POST /api/cron/run (expire unpaid orders, reconcile payments, send SMS/email, purge data)
CRON_SECRET=replace-with-another-random-secret

# --- Notifications (optional) ----------------------------------------------------
# log = write to server log only (default), hubtel = Hubtel SMS, none = off
NOTIFY_SMS_PROVIDER=log
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
# Sender ID approved by Hubtel (max 11 chars)
HUBTEL_SMS_SENDER=
# log | resend | none
NOTIFY_EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Bite & Sips <orders@example.com>

# --- Optional ----------------------------------------------------------------
# Map subdomains to portals (same app): admin.biteandsips.com → /admin, etc.
ADMIN_HOST=
KITCHEN_HOST=
RIDER_HOST=
# Where uploaded menu photos are stored (needs a persistent disk in production)
UPLOAD_DIR=
# Set true when the site runs behind a proxy/CDN (Vercel, Cloudflare, nginx...). While false, all visitors share one
# rate-limit bucket, which is fine on your own PC but wrong on a live site.
TRUST_PROXY=false
# How many trusted proxies/CDNs are in front of the app (each adds to X-Forwarded-For). Only used when TRUST_PROXY=true.
# Add 1 if Next.js forwards /api to the separate backend (BACKEND_URL).
TRUSTED_PROXY_HOPS=1
DATABASE_POOL_MAX=10
# Simulated delivery partner for development demos (never available in production)
DELIVERY_SANDBOX_PROVIDER=false

# Optional: run the API as a separate backend service (see docs/BACKEND.md)
# BACKEND_URL=http://localhost:4000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# BACKEND_PORT=4000
# CORS_ORIGINS=http://localhost:3001
